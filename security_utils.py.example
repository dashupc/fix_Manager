import base64
import os
from cryptography.fernet import Fernet
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
import base64 as b64

# 方案1: 简单 Base64 编码（基础防护，不推荐用于生产环境）
def simple_encrypt(text):
    """简单的 Base64 编码（仅用于防止明文存储，不是真正的加密）"""
    if not text:
        return ''
    encoded = base64.b64encode(text.encode('utf-8')).decode('utf-8')
    return encoded

def simple_decrypt(encoded_text):
    """Base64 解码"""
    if not encoded_text:
        return ''
    try:
        decoded = base64.b64decode(encoded_text.encode('utf-8')).decode('utf-8')
        return decoded
    except Exception:
        return ''

# 方案2: 使用 Fernet 对称加密（推荐）
class SecureStorage:
    """安全的密码存储类"""
    
    def __init__(self, key_file='.encryption_key'):
        """初始化加密存储
        key_file: 存储加密密钥的文件路径
        """
        self.key_file = key_file
        self.key = self._get_or_create_key()
        self.cipher = Fernet(self.key)
    
    def _get_or_create_key(self):
        """获取或创建加密密钥"""
        if os.path.exists(self.key_file):
            with open(self.key_file, 'rb') as f:
                return f.read()
        else:
            # 生成新密钥
            key = Fernet.generate_key()
            with open(self.key_file, 'wb') as f:
                f.write(key)
            # 设置文件权限（仅限当前用户）
            if os.name != 'nt':  # Windows 不需要
                os.chmod(self.key_file, 0o600)
            return key
    
    def encrypt(self, plaintext):
        """加密文本"""
        if not plaintext:
            return ''
        try:
            encrypted = self.cipher.encrypt(plaintext.encode('utf-8'))
            return base64.b64encode(encrypted).decode('utf-8')
        except Exception as e:
            print(f"加密失败: {e}")
            return plaintext  # 加密失败时返回原文
    
    def decrypt(self, ciphertext):
        """解密文本"""
        if not ciphertext:
            return ''
        try:
            decoded = base64.b64decode(ciphertext.encode('utf-8'))
            decrypted = self.cipher.decrypt(decoded)
            return decrypted.decode('utf-8')
        except Exception as e:
            print(f"解密失败: {e}")
            return ciphertext  # 解密失败时返回原文


